.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 60rpx 0;
}

.logo {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  color: #333;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
  margin-bottom: 120rpx;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
}

.tip {
  position: fixed;
  bottom: 60rpx;
  font-size: 22rpx;
  color: #bbb;
}
