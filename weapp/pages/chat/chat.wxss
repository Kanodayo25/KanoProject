.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f6fa;
}

/* RAG 参数栏 */
.param-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #eee;
}

.param-input {
  flex: 1;
  height: 60rpx;
  background: #f5f6fa;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  margin-right: 16rpx;
}

.param-picker .picker-value {
  height: 60rpx;
  line-height: 60rpx;
  background: #f0f4ff;
  color: #4a67ff;
  font-size: 24rpx;
  border-radius: 10rpx;
  padding: 0 20rpx;
}

.clear-btn {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 8rpx;
}

/* 消息列表 */
.msg-list {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.empty {
  text-align: center;
  padding-top: 160rpx;
}

.empty-icon {
  font-size: 90rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #aaa;
}

.msg {
  display: flex;
  margin-bottom: 24rpx;
}

.msg-user {
  flex-direction: row-reverse;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #e6e9ff;
  color: #4a67ff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.msg-user .avatar {
  background: #4a67ff;
  color: #fff;
}

.bubble {
  max-width: 70%;
  margin: 0 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.msg-ai .bubble {
  background: #fff;
  border: 1rpx solid #eee;
}

.msg-user .bubble {
  background: #4a67ff;
  color: #fff;
}

.bubble-img {
  display: block;
  max-width: 320rpx;
  border-radius: 10rpx;
  margin-bottom: 8rpx;
}

.typing {
  color: #999;
}

/* 输入栏 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
}

.attach-btn {
  font-size: 44rpx;
  margin-right: 16rpx;
  line-height: 1;
  padding: 4rpx;
}

.img-preview {
  position: relative;
  margin-right: 16rpx;
}

.img-preview image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
  display: block;
}

.img-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 32rpx;
  height: 32rpx;
  line-height: 30rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
}

.input {
  flex: 1;
  height: 76rpx;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 16rpx;
  background: #4a67ff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 0 32rpx;
  line-height: 76rpx;
  height: 76rpx;
}

.send-btn[disabled] {
  background: #aab3ff;
  color: #fff;
}
